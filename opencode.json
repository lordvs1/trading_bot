{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      }
    }
  },
  "permission": {
    "read": { ".env": "deny", ".env.*": "deny", "**/.env": "deny", "**/.env.*": "deny", ".env.example": "allow", "**/.env.example": "allow" },
    "edit": { ".env": "deny", ".env.*": "deny", "**/.env": "deny", "**/.env.*": "deny", ".env.example": "allow", "**/.env.example": "allow" },
    "grep": { ".env": "deny", ".env.*": "deny", "**/.env": "deny", "**/.env.*": "deny", ".env.example": "allow", "**/.env.example": "allow" }
  }
}
